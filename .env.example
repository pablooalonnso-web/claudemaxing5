# Public JSON-RPC endpoint for Robinhood Chain (chain id 4663).
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Public origin of this deployment (used for Open Graph metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: an upstream snapshot API implementing GET /v1/public/vaults.
# When unset, /api/public/vaults reads every vault directly from the chain.
UPSTREAM_API_URL=

# Optional: Uniswap V3 QuoterV2 / SwapRouter02 on Robinhood Chain for the Trade page.
NEXT_PUBLIC_UNISWAP_QUOTER=
NEXT_PUBLIC_UNISWAP_ROUTER=

# Optional: support portal linked from /help/contact.
NEXT_PUBLIC_SUPPORT_URL=

# Optional: protocol token contract (defaults to the deployed token on Robinhood Chain).
NEXT_PUBLIC_TOKEN_ADDRESS=
